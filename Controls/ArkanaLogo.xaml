<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Arkana.Controls.ArkanaLogo">

    <Label x:Name="LogoLabel" FontSize="32" FontAttributes="Bold">
        <Label.FormattedText>
            <FormattedString>
                <Span Text="Ark" TextColor="{StaticResource ArkTextPrimary}"/>
                <Span Text="ana" TextColor="{StaticResource ArkAccent}"/>
            </FormattedString>
        </Label.FormattedText>
    </Label>

</ContentView>