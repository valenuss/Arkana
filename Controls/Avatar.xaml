<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Arkana.Controls.Avatar">

    <Border x:Name="Ring"
            Stroke="{StaticResource ArkAccent}"
            BackgroundColor="{StaticResource ArkSurfaceRaised}"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Label x:Name="InitialLabel" Text="?" FontAttributes="Bold"
               TextColor="{StaticResource ArkTextPrimary}"
               HorizontalOptions="Center" VerticalOptions="Center"/>
    </Border>

</ContentView>