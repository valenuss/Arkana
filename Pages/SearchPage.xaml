<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.SearchPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="18,12">

        <!-- título -->
        <Label Grid.Row="0" Text="Explorar usuarios" Style="{StaticResource Heading}"
               Margin="0,5,0,15"/>

        <!-- buscador -->
        <Border Grid.Row="1" Style="{StaticResource FieldBox}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔍" FontSize="16" VerticalOptions="Center"/>
                <Entry Grid.Column="1" x:Name="SearchEntry"
                       Placeholder="Buscar usuarios..."
                       Style="{StaticResource FieldEntry}"
                       HeightRequest="48"
                       Text="{Binding Query, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- filtros -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,14">
            <controls:FilterChip Text="Todos" Value="Todos"
                                 SelectedValue="{Binding Filter, Mode=TwoWay}"/>
            <controls:FilterChip Text="Siguiendo" Value="Siguiendo"
                                 SelectedValue="{Binding Filter, Mode=TwoWay}"/>
            <controls:FilterChip Text="Sugeridos" Value="Sugeridos"
                                 SelectedValue="{Binding Filter, Mode=TwoWay}"/>
        </HorizontalStackLayout>

        <!-- lista de usuarios -->
        <CollectionView Grid.Row="3" x:Name="UsersList"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                        ItemsSource="{Binding Users, Mode=OneWay}">

            <CollectionView.EmptyView>
                <Label Text="No se encontraron usuarios" Style="{StaticResource Subheading}"
                       HorizontalOptions="Center" Margin="0,40"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10">

                        <controls:Avatar Diameter="48" Initial="{Binding Initial}"/>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Name}" Style="{StaticResource Body}" FontAttributes="Bold"/>
                            <Label Text="{Binding Handle}" Style="{StaticResource Caption}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2" Text="{Binding FollowText}"
                                Style="{StaticResource FollowButton}"
                                VerticalOptions="Center"
                                Clicked="Follow_Clicked"/>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>