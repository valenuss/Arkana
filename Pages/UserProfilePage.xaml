<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.UserProfilePage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- barra de arriba con flecha para volver -->
        <Grid Grid.Row="0" ColumnDefinitions="48,*,48" Padding="18,12">

            <Label Text="←" FontSize="26" TextColor="{StaticResource ArkTextPrimary}"
                   VerticalOptions="Center" AutomationProperties.Name="Volver">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Back_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1" Text="{Binding Handle, Mode=OneWay}" Style="{StaticResource Heading}"
                   FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>

        </Grid>

        <!-- publicaciones del usuario, con el perfil arriba -->
        <CollectionView Grid.Row="1" SelectionMode="None"
                        ItemsSource="{Binding Posts, Mode=OneWay}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="18,5,18,10" Spacing="10">

                    <controls:Avatar Diameter="90" Initial="{Binding Initial, Mode=OneWay}"
                                     HorizontalOptions="Center"/>

                    <Label Text="{Binding Name, Mode=OneWay}" Style="{StaticResource Heading}"
                           HorizontalOptions="Center"/>

                    <!-- números -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,10">

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding PostsCount, Mode=OneWay}" Style="{StaticResource StatValue}"/>
                            <Label Text="Publicaciones" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding FollowersCount, Mode=OneWay}" Style="{StaticResource StatValue}"/>
                            <Label Text="Seguidores" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="{Binding FollowingCount, Mode=OneWay}" Style="{StaticResource StatValue}"/>
                            <Label Text="Siguiendo" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- botón seguir (no sale en tu propio perfil) -->
                    <Button Text="{Binding FollowText, Mode=OneWay}"
                            Style="{StaticResource FollowButton}"
                            IsVisible="{Binding IsOtherUser, Mode=OneWay}"
                            CornerRadius="22" HeightRequest="44"
                            Clicked="Follow_Clicked"/>

                    <Label Text="Publicaciones" Style="{StaticResource Body}"
                           FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>

                    <Label Text="Todavía no tiene publicaciones" Style="{StaticResource Subheading}"
                           FontSize="13" IsVisible="{Binding HasNoPosts, Mode=OneWay}"/>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- cómo se ve cada publicación -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="14,6">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Content}" Style="{StaticResource Body}"/>
                            <HorizontalStackLayout Spacing="14">
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                       Style="{StaticResource Caption}"/>
                                <Label Text="{Binding Likes, StringFormat='❤️ {0}'}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource ArkTextSecondary}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>