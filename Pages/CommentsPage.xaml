<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    xmlns:helpers="clr-namespace:Arkana.Helpers"
    x:Class="Arkana.Pages.CommentsPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- barra de arriba -->
        <Grid Grid.Row="0" ColumnDefinitions="48,*,48" Padding="18,12">

            <Label Text="{x:Static helpers:Icons.ArrowBack}" Style="{StaticResource IconLabel}"
                   AutomationProperties.Name="Volver">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Back_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1" Text="Comentarios" Style="{StaticResource Heading}"
                   FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>

        </Grid>

        <!-- lista de comentarios -->
        <CollectionView Grid.Row="1" x:Name="CommentsList" SelectionMode="None"
                        ItemsSource="{Binding Comments, Mode=OneWay}">

            <CollectionView.EmptyView>
                <Label Text="Sé el primero en comentar" Style="{StaticResource Subheading}"
                       HorizontalOptions="Center" Margin="0,40"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="18,8">

                        <controls:Avatar Diameter="36" Initial="{Binding Initial}" VerticalOptions="Start"/>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Username}" Style="{StaticResource Body}"
                                       FontSize="14" FontAttributes="Bold"/>
                                <Label Text="{Binding TimeAgo}" Style="{StaticResource Caption}"
                                       FontSize="11" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Text}" Style="{StaticResource Body}" FontSize="14"/>
                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- escribir un comentario -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="18,10"
              BackgroundColor="{StaticResource ArkBackground}">

            <Border Style="{StaticResource FieldBox}" StrokeShape="RoundRectangle 22">
                <Entry Placeholder="Escribe un comentario..."
                       Style="{StaticResource FieldEntry}"
                       Text="{Binding NewText, Mode=TwoWay}"
                       Completed="Send_Requested"/>
            </Border>

            <Label Grid.Column="1" Text="{x:Static helpers:Icons.Send}" Style="{StaticResource IconLabel}"
                   TextColor="{StaticResource ArkAccent}"
                   AutomationProperties.Name="Enviar comentario">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Send_Requested"/>
                </Label.GestureRecognizers>
            </Label>

        </Grid>

    </Grid>

</ContentPage> 