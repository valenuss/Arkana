<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.ProfilePage"
    Title="Mi perfil"
    BackgroundColor="{StaticResource ArkBackground}">

    <CollectionView x:Name="MyPostsList" SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout Padding="24,20,24,10" Spacing="10">

                <controls:Avatar x:Name="ProfileAvatar" Diameter="100" HorizontalOptions="Center"/>

                <Label x:Name="NameLabel" Text="Nombre" Style="{StaticResource Heading}"
                       FontSize="24" HorizontalOptions="Center"/>
                <Label x:Name="UsernameLabel" Text="@usuario" Style="{StaticResource Subheading}"
                       HorizontalOptions="Center"/>

                <!-- números -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0,16">
                    <Grid ColumnDefinitions="*,*,*">

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="PostsLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Publicaciones" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label x:Name="FollowersLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Seguidores" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label x:Name="FollowingLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Siguiendo" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- cerrar sesión -->
                <Button Text="Cerrar sesión"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ArkTextPrimary}"
                        BorderColor="{StaticResource ArkBorder}" BorderWidth="1"
                        CornerRadius="22" HeightRequest="44"
                        Clicked="Logout_Clicked"/>

                <Label Text="Mis publicaciones" Style="{StaticResource Body}"
                       FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>

                <Label x:Name="EmptyLabel" Text="Todavía no has publicado nada"
                       Style="{StaticResource Subheading}" FontSize="13" IsVisible="False"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- cómo se ve cada publicación -->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="14,6">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="{Binding Content}" Style="{StaticResource Body}"/>

                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                IsVisible="{Binding HasImage}">
                            <Image Source="{Binding Photo}" Aspect="AspectFill" HeightRequest="200"/>
                        </Border>

                        <HorizontalStackLayout Spacing="14">
                            <Label Text="{Binding DateText}" Style="{StaticResource Caption}"/>
                            <Label Text="{Binding Likes, StringFormat='❤️ {0}'}"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource ArkTextSecondary}"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>