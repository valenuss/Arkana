<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.ProfilePage"
    Title="Mi perfil"
    BackgroundColor="{StaticResource ArkBackground}">

    <!-- cuadrícula de 3 columnas, como Instagram -->
    <CollectionView x:Name="MyPostsList" SelectionMode="None" Margin="3,0">

        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="3"
                             HorizontalItemSpacing="3" VerticalItemSpacing="3"/>
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Padding="21,20,21,10" Spacing="10">

                <controls:Avatar x:Name="ProfileAvatar" Diameter="100" HorizontalOptions="Center"/>

                <Label x:Name="NameLabel" Text="Nombre" Style="{StaticResource Heading}"
                       FontSize="24" HorizontalOptions="Center"/>
                <Label x:Name="UsernameLabel" Text="@usuario" Style="{StaticResource Subheading}"
                       HorizontalOptions="Center"/>

                <!-- números -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0,16">
                    <Grid ColumnDefinitions="*,*,*">

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="PostsLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Publicaciones" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label x:Name="FollowersLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Seguidores" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label x:Name="FollowingLabel" Text="0" Style="{StaticResource StatValue}"/>
                            <Label Text="Siguiendo" Style="{StaticResource StatCaption}"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- cerrar sesión -->
                <Button Text="Cerrar sesión"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ArkTextPrimary}"
                        BorderColor="{StaticResource ArkBorder}" BorderWidth="1"
                        CornerRadius="22" HeightRequest="44"
                        Clicked="Logout_Clicked"/>

                <Label Text="Mis publicaciones" Style="{StaticResource Body}"
                       FontSize="16" FontAttributes="Bold" Margin="0,10,0,4"/>

                <Label x:Name="EmptyLabel" Text="Todavía no has publicado nada"
                       Style="{StaticResource Subheading}" FontSize="13" IsVisible="False"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- cada publicación es un cuadro -->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0"
                        BackgroundColor="{StaticResource ArkSurface}" HeightRequest="124">
                    <Grid>

                        <!-- con foto: la foto llena el cuadro -->
                        <Image Source="{Binding Photo}" Aspect="AspectFill" IsVisible="{Binding HasImage}"/>

                        <!-- solo texto: el texto en el cuadro -->
                        <Label Text="{Binding Content}" IsVisible="{Binding IsTextOnly}"
                               Style="{StaticResource Body}" FontSize="12"
                               MaxLines="5" LineBreakMode="TailTruncation"
                               Margin="10" VerticalOptions="Center"/>

                        <!-- me gusta -->
                        <Border BackgroundColor="#99000000" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" Padding="7,2"
                                HorizontalOptions="Start" VerticalOptions="End" Margin="6">
                            <Label Text="{Binding Likes, StringFormat='❤ {0}'}"
                                   FontSize="11" TextColor="White"/>
                        </Border>

                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>