<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.LoginPage"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid>
        <!-- imagen de fondo -->
        <Image Source="descarga.png" Aspect="AspectFill"
               HorizontalOptions="Fill" VerticalOptions="Fill"/>

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

                <controls:ArkanaLogo FontSize="40" HorizontalOptions="Center"/>

                <!-- formulario -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4" Margin="0,0,0,6">
                            <Label Text="Bienvenido de nuevo" Style="{StaticResource Heading}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Inicia sesión para continuar" Style="{StaticResource Subheading}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- correo o usuario -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="👤" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="EmailEntry"
                                       Placeholder="Correo electrónico o usuario"
                                       Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <!-- contraseña con ojito -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="🔒" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="PasswordEntry"
                                       Placeholder="Contraseña" IsPassword="True"
                                       Style="{StaticResource FieldEntry}"/>
                                <Label Grid.Column="2" Text="👁" FontSize="18" VerticalOptions="Center"
                                       AutomationProperties.Name="Mostrar u ocultar contraseña">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ShowPassword_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>

                        <!-- recordarme y olvidaste -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Color="{StaticResource ArkAccent}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Recordarme" Style="{StaticResource Caption}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="¿Olvidaste tu contraseña?" Style="{StaticResource Caption}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Button Text="Iniciar sesión" Style="{StaticResource PrimaryButton}"
                                Clicked="LoginButton_Clicked"/>

                        <!-- separador -->
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                            <BoxView Color="{StaticResource ArkBorder}" HeightRequest="1" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="o" Style="{StaticResource Caption}"/>
                            <BoxView Grid.Column="2" Color="{StaticResource ArkBorder}" HeightRequest="1" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Google, solo de adorno por ahora -->
                        <Border BackgroundColor="Transparent" Stroke="{StaticResource ArkBorder}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 25" HeightRequest="50">
                            <Label Text="G   Continuar con Google" Style="{StaticResource Body}"
                                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- registro -->
                <Label HorizontalOptions="Center" FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿No tienes cuenta? " TextColor="{StaticResource ArkTextMuted}"/>
                            <Span Text="Regístrate" TextColor="{StaticResource ArkAccent}" FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Register_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>