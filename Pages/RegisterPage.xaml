<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.RegisterPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid>
        <!-- imagen de fondo -->
        <Image Source="descarga.png" Aspect="AspectFill"
               HorizontalOptions="Fill" VerticalOptions="Fill"/>

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

                <controls:ArkanaLogo FontSize="40" HorizontalOptions="Center"/>

                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="4" Margin="0,0,0,6">
                            <Label Text="Crear cuenta" Style="{StaticResource Heading}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Únete a Arkana" Style="{StaticResource Subheading}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- nombre -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="👤" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="NameEntry" Placeholder="Nombre"
                                       Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <!-- usuario -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="🏷️" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="UsernameEntry" Placeholder="Nombre de usuario"
                                       Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <!-- correo -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="📧" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="Correo electrónico"
                                       Keyboard="Email" Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <!-- contraseña -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="🔒" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Contraseña"
                                       IsPassword="True" Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <!-- confirmar -->
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="🔑" FontSize="18" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" x:Name="ConfirmPasswordEntry" Placeholder="Confirmar contraseña"
                                       IsPassword="True" Style="{StaticResource FieldEntry}"/>
                            </Grid>
                        </Border>

                        <Button Text="Crear cuenta" Style="{StaticResource PrimaryButton}"
                                Clicked="RegisterButton_Clicked" Margin="0,6,0,0"/>

                    </VerticalStackLayout>
                </Border>

                <!-- volver al login -->
                <Label HorizontalOptions="Center" FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="¿Ya tienes cuenta? " TextColor="{StaticResource ArkTextMuted}"/>
                            <Span Text="Inicia sesión" TextColor="{StaticResource ArkAccent}" FontAttributes="Bold"/>
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Login_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>