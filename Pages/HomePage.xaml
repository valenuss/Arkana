<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    x:Class="Arkana.Pages.HomePage"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- barra de arriba -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Padding="18,12">

            <controls:ArkanaLogo FontSize="26" HorizontalOptions="Start" VerticalOptions="Center"/>

            <Label Grid.Column="1" Text="🔍" FontSize="22" VerticalOptions="Center"
                   AutomationProperties.Name="Buscar"/>
            <Label Grid.Column="2" Text="🔔" FontSize="22" VerticalOptions="Center"
                   AutomationProperties.Name="Notificaciones"/>

            <!-- cerrar sesión -->
            <Label Grid.Column="3" Text="🚪" FontSize="22" VerticalOptions="Center"
                   AutomationProperties.Name="Cerrar sesión">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Logout_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

        </Grid>

        <!-- lista de publicaciones, con las historias arriba -->
        <CollectionView x:Name="PostsList" Grid.Row="1" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout>

                    <!-- historias -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Padding="18,5,18,10" Spacing="14">

                            <!-- tu historia -->
                            <VerticalStackLayout Spacing="5" WidthRequest="68">
                                <Grid WidthRequest="64" HeightRequest="64">
                                    <controls:Avatar x:Name="StoryAvatar" Diameter="64"/>
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource ArkAccent}"
                                            Stroke="{StaticResource ArkBackground}" StrokeThickness="2"
                                            WidthRequest="20" HeightRequest="20"
                                            HorizontalOptions="End" VerticalOptions="End">
                                        <Label Text="+" TextColor="{StaticResource ArkTextPrimary}" FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                                <Label Text="Tu historia" Style="{StaticResource StoryName}"/>
                            </VerticalStackLayout>

                            <!-- historias de los demás usuarios -->
                            <HorizontalStackLayout x:Name="StoriesLayout" Spacing="14">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="5" WidthRequest="68">
                                            <controls:Avatar Diameter="64" Initial="{Binding Initial}"/>
                                            <Label Text="{Binding Username}" Style="{StaticResource StoryName}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- ¿qué estás pensando? -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="18,8,18,12">

                        <controls:Avatar x:Name="ComposerAvatar" Diameter="40"/>

                        <Border Grid.Column="1" Style="{StaticResource FieldBox}"
                                StrokeShape="RoundRectangle 20" HeightRequest="40" Padding="15,0">
                            <Label Text="¿Qué estás pensando?" Style="{StaticResource Subheading}"
                                   VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NewPost_Tapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- cómo se ve cada publicación -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="14,6">

                        <VerticalStackLayout Spacing="12">

                            <!-- quién publicó -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                <controls:Avatar Diameter="40" Initial="{Binding Initial}"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Username}" Style="{StaticResource Body}"
                                           FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding TimeAgo}" Style="{StaticResource Caption}" FontSize="11"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="⋮" FontSize="20" VerticalOptions="Center"
                                       TextColor="{StaticResource ArkTextMuted}"/>

                            </Grid>

                            <!-- texto -->
                            <Label Text="{Binding Content}" Style="{StaticResource Body}"/>

                            <!-- me gusta, comentar, compartir -->
                            <HorizontalStackLayout Spacing="22">

                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Heart}" FontSize="22" VerticalOptions="Center"
                                           AutomationProperties.Name="Me gusta">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Like_Tapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding Likes}" FontSize="13" VerticalOptions="Center"
                                           TextColor="{StaticResource ArkTextSecondary}"/>
                                </HorizontalStackLayout>

                                <Label Text="💬" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="📤" FontSize="20" VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>