<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    xmlns:helpers="clr-namespace:Arkana.Helpers"
    x:Class="Arkana.Pages.HomePage"
    BackgroundColor="{StaticResource ArkBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- barra de arriba -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Padding="18,12">

            <controls:ArkanaLogo FontSize="26" HorizontalOptions="Start" VerticalOptions="Center"/>

            <Label Grid.Column="1" Text="{x:Static helpers:Icons.Search}"
                    Style="{StaticResource IconLabel}"
                    AutomationProperties.Name="Buscar">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Search_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <!-- campanita con contador -->
            <Grid Grid.Column="2" AutomationProperties.Name="Notificaciones">
                <Label Text="{x:Static helpers:Icons.Notifications}" Style="{StaticResource IconLabel}"/>

                <Border x:Name="BellBadge" IsVisible="False"
                        BackgroundColor="{StaticResource ArkAccent}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 9"
                        MinimumWidthRequest="18" HeightRequest="18" Padding="4,0"
                        HorizontalOptions="End" VerticalOptions="Start" Margin="0,-4,-6,0">
                    <Label x:Name="BellBadgeLabel" Text="0" FontSize="10" FontAttributes="Bold"
                           TextColor="{StaticResource ArkTextPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Bell_Tapped"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- cerrar sesión -->
            <Label Grid.Column="3" Text="{x:Static helpers:Icons.Logout}"
                   Style="{StaticResource IconLabel}"
                   AutomationProperties.Name="Cerrar sesión">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Logout_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

        </Grid>

        <!-- lista de publicaciones, con las historias arriba -->
        <CollectionView x:Name="PostsList" Grid.Row="1" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout>

                    <!-- historias -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Padding="18,5,18,10" Spacing="14">

                            <!-- tu historia: tocar la foto la abre, tocar el + agrega otra -->
                            <VerticalStackLayout Spacing="5" WidthRequest="68">
                                <Grid WidthRequest="64" HeightRequest="64">
                                    <controls:Avatar x:Name="StoryAvatar" Diameter="64">
                                        <controls:Avatar.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="MyStory_Tapped"/>
                                        </controls:Avatar.GestureRecognizers>
                                    </controls:Avatar>

                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource ArkAccent}"
                                            Stroke="{StaticResource ArkBackground}" StrokeThickness="2"
                                            WidthRequest="20" HeightRequest="20"
                                            HorizontalOptions="End" VerticalOptions="End">
                                        <Label Text="+" TextColor="{StaticResource ArkTextPrimary}" FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="AddStory_Tapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                                <Label Text="Tu historia" Style="{StaticResource StoryName}"/>
                            </VerticalStackLayout>

                            <!-- historias de la gente que sigues -->
                            <HorizontalStackLayout x:Name="StoriesLayout" Spacing="14">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="5" WidthRequest="68">
                                            <controls:Avatar Diameter="64" Initial="{Binding Initial}"/>
                                            <Label Text="{Binding Username}" Style="{StaticResource StoryName}"/>
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="Story_Tapped"/>
                                            </VerticalStackLayout.GestureRecognizers>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- ¿qué estás pensando? -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="18,8,18,12">

                        <controls:Avatar x:Name="ComposerAvatar" Diameter="40"/>

                        <Border Grid.Column="1" Style="{StaticResource FieldBox}"
                                StrokeShape="RoundRectangle 20" HeightRequest="40" Padding="15,0">
                            <Label Text="¿Qué estás pensando?" Style="{StaticResource Subheading}"
                                   VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NewPost_Tapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- cómo se ve cada publicación -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="14,6">

                        <VerticalStackLayout Spacing="12">

                            <!-- quién publicó -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                <controls:Avatar Diameter="40" Initial="{Binding Initial}"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Username}" Style="{StaticResource Body}"
                                           FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="{Binding TimeAgo}" Style="{StaticResource Caption}" FontSize="11"/>
                                </VerticalStackLayout>

                                <!-- los 3 puntos: editar o eliminar -->
                                <Label Grid.Column="2" Text="{x:Static helpers:Icons.MoreVert}"
                                       Style="{StaticResource IconLabel}"
                                       FontSize="22" TextColor="{StaticResource ArkTextMuted}"
                                       AutomationProperties.Name="Opciones de la publicación">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="More_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>

                            <!-- texto -->
                            <Label Text="{Binding Content}" Style="{StaticResource Body}"/>

                            <!-- foto de la publicación -->
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    IsVisible="{Binding HasImage}">
                                <Image Source="{Binding Photo}" Aspect="AspectFill" HeightRequest="240"/>
                            </Border>

                            <!-- me gusta, comentar, compartir -->
                            <HorizontalStackLayout Spacing="22">

                                <!-- me gusta -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Heart}" Style="{StaticResource LikeIcon}"
                                           AutomationProperties.Name="Me gusta">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Like_Tapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding Likes}" FontSize="13" VerticalOptions="Center"
                                           TextColor="{StaticResource ArkTextSecondary}"/>
                                </HorizontalStackLayout>

                                <!-- comentarios -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{x:Static helpers:Icons.ChatBubbleOutline}"
                                           Style="{StaticResource IconLabel}"
                                           FontSize="22" TextColor="{StaticResource ArkTextMuted}"/>
                                    <Label Text="{Binding CommentsCount}" FontSize="13" VerticalOptions="Center"
                                           TextColor="{StaticResource ArkTextSecondary}"/>
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Comments_Tapped"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>

                                <!-- compartir -->
                                <Label Text="{x:Static helpers:Icons.Share}"
                                       Style="{StaticResource IconLabel}"
                                       FontSize="22" TextColor="{StaticResource ArkTextMuted}"
                                       AutomationProperties.Name="Compartir">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Share_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>