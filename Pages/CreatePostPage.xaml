<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Arkana.Pages.CreatePostPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#12040A">

    <Grid>

        <!-- fondo con capa oscura para que todo se lea bien -->
        <Image Source="descarga.png" Aspect="AspectFill" InputTransparent="True"
               HorizontalOptions="Fill" VerticalOptions="Fill"/>
        <BoxView Color="#4D12040A" InputTransparent="True"/>

        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18">

            <!-- barra de arriba -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="0,5,0,15">

                <Label Text="✕" FontSize="22" TextColor="White" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Close_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1" Text="Crear publicación" FontSize="18" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>

            </Grid>

            <!-- quien publica -->
            <Border Grid.Row="1" BackgroundColor="#CC240E18" Stroke="#40E0A8B0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <Border StrokeShape="RoundRectangle 22" Stroke="#FF1F3D" StrokeThickness="2"
                            WidthRequest="44" HeightRequest="44" BackgroundColor="#3A1623">
                        <Label x:Name="InitialLabel" Text="?" FontSize="18" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="NameLabel" Text="Nombre" TextColor="White"
                               FontAttributes="Bold" FontSize="15"/>
                        <Label x:Name="UsernameLabel" Text="@usuario" TextColor="#CDB4BA" FontSize="12"/>
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- donde se escribe -->
            <Border Grid.Row="2" BackgroundColor="#CC240E18" Stroke="#40E0A8B0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="14" Margin="0,15,0,0">
                <Editor x:Name="ContentEditor"
                        Placeholder="¿Qué estás pensando?"
                        PlaceholderColor="#A88A92"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        FontSize="17"
                        MaxLength="280"
                        TextChanged="ContentEditor_TextChanged"/>
            </Border>

            <!-- contador y boton -->
            <VerticalStackLayout Grid.Row="3" Spacing="10" Margin="0,12,0,0">

                <Label x:Name="CounterLabel" Text="0 / 280" TextColor="#CDB4BA" FontSize="12"
                       HorizontalOptions="End"/>

                <Button Text="Publicar"
                        Clicked="Publish_Clicked"
                        BackgroundColor="#FF1F3D"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50" CornerRadius="25"/>

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>