<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Arkana.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arkana.Controls"
    xmlns:pages="clr-namespace:Arkana.Pages"
    xmlns:info="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials"
    Title="Arkana"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource ArkSurface}"
    BackgroundColor="{StaticResource ArkBackground}"
    Shell.BackgroundColor="{StaticResource ArkBackground}"
    Shell.ForegroundColor="{StaticResource ArkTextPrimary}"
    Shell.TitleColor="{StaticResource ArkTextPrimary}"
    Shell.TabBarBackgroundColor="{StaticResource ArkBackground}"
    Shell.TabBarTitleColor="{StaticResource ArkAccent}"
    Shell.TabBarUnselectedColor="{StaticResource ArkTextMuted}">

    <!-- ============ MENÚ LATERAL ============ -->

    <Shell.FlyoutHeader>
        <Grid Padding="22,45,22,22" BackgroundColor="{StaticResource ArkBackground}">
            <controls:ArkanaLogo FontSize="32" HorizontalOptions="Start"/>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="22,15">
            <Label Text="{x:Static info:AppInfo.Name}" Style="{StaticResource Caption}"/>
            <Label Text="{x:Static info:AppInfo.VersionString}" Style="{StaticResource Caption}"/>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="22,14">
                <Label Text="{Binding Text}" Style="{StaticResource Body}"
                       FontSize="16" VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <!-- ============ PANTALLAS ============ -->

    <!-- login -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login"
        Shell.NavBarIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        FlyoutItemIsVisible="False"/>

    <!-- barra de pestañas -->
    <TabBar Route="main">

        <ShellContent
            Title="🏠 Inicio"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Shell.NavBarIsVisible="False"/>

        <ShellContent
            Title="🔍 Buscar"
            ContentTemplate="{DataTemplate pages:SearchPage}"/>

        <ShellContent
            Title="👤 Perfil"
            ContentTemplate="{DataTemplate pages:ProfilePage}"/>

    </TabBar>

    <!-- opciones del menú lateral -->
    <MenuItem Text="Acerca de Arkana" Clicked="About_Clicked"/>
    <MenuItem Text="Documentación" Clicked="Docs_Clicked"/>
    <MenuItem Text="Cerrar sesión" Clicked="Logout_Clicked"/>

</Shell>